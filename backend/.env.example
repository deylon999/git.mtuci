# PostgreSQL Database Configuration
POSTGRES_USER=mtuci
POSTGRES_PASSWORD=mtuci
POSTGRES_DB=mtuci_app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL (auto-generated from POSTGRES_* variables, can be overridden)
DATABASE_URL=postgresql+asyncpg://mtuci:mtuci@postgres:5432/mtuci_app

# JWT Authentication
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=dev-secret-key-63d3de08-f361-4b2c-be30-f097f498d8f7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Settings
DB_ECHO=false

# Gitea Configuration
# GITEA_URL — internal URL for API/backend (Docker: http://gitea:3000)
GITEA_URL=http://gitea:3000
# GITEA_PUBLIC_URL — URL students see in browser and git clone (e.g. https://git.university.ru)
GITEA_PUBLIC_URL=http://localhost:3000
# API token (Gitea → Settings → Applications). Leave empty to use GITEA_ADMIN_* basic auth.
# After first Gitea install, create gitea_admin (or use install wizard) before starting API.
GITEA_TOKEN=
GITEA_ADMIN_USERNAME=gitea_admin
GITEA_ADMIN_PASSWORD=admin12345
GITEA_WEBHOOK_SECRET=dev-webhook-secret-2024
# URL Gitea uses to POST webhooks (must reach your API from Gitea container)
WEBHOOK_BASE_URL=http://api:8000/webhooks

# Super Admin Bootstrap (created on first startup)
ADMIN_EMAIL=admin@mtuci.local
ADMIN_PASSWORD=admin123

# Frontend URL (for password reset links and CORS)
FRONTEND_URL=http://localhost:3001

# SMTP Configuration (for password reset emails)
# Leave empty to disable password reset functionality
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

