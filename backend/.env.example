# PostgreSQL Database Configuration
POSTGRES_USER=mtuci
POSTGRES_PASSWORD=mtuci
POSTGRES_DB=mtuci_app
# Inside Docker network use "postgres". On Windows/macOS host (alembic, local API) use "localhost"
# if Postgres is started via docker compose (port 5432 published).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL (auto-generated from POSTGRES_* variables, can be overridden)
# Host "postgres" is auto-replaced with localhost when the name does not resolve (local alembic).
DATABASE_URL=postgresql+asyncpg://mtuci:mtuci@postgres:5432/mtuci_app

# JWT Authentication
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=dev-secret-key-63d3de08-f361-4b2c-be30-f097f498d8f7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Stable secret used to encrypt MTUCI LK passwords at rest.
# If omitted, JWT_SECRET_KEY is used; keep this value stable after production deploy.
MTUCI_CREDENTIALS_SECRET=dev-mtuci-credentials-secret-2026

# Database Settings
DB_ECHO=false

# Gitea Configuration
# GITEA_URL — internal URL for API/backend (Docker: http://gitea:3000)
GITEA_URL=http://gitea:3000
# GITEA_PUBLIC_URL — URL students see in browser and git clone (e.g. https://git.university.ru)
GITEA_PUBLIC_URL=http://localhost:3000
# API token (Gitea → Settings → Applications → Generate New Token).
# Leave empty to use GITEA_ADMIN_* basic auth (recommended for local Docker).
# If API logs "GITEA_TOKEN rejected", remove the bad token or generate a new one.
GITEA_TOKEN=
GITEA_ADMIN_USERNAME=gitea_admin
GITEA_ADMIN_PASSWORD=admin12345
GITEA_WEBHOOK_SECRET=dev-webhook-secret-2024
# URL Gitea uses to POST webhooks (must reach your API from Gitea container)
WEBHOOK_BASE_URL=http://api:8000/webhooks

# Super Admin Bootstrap (created on first startup)
ADMIN_EMAIL=admin@mtuci.local
ADMIN_PASSWORD=admin123

# Frontend URL (for password reset links and CORS)
FRONTEND_URL=http://localhost:3001
# Health probe from API container (Docker: http://frontend:3001)
# FRONTEND_HEALTH_URL=http://frontend:3001

# SMTP Configuration (for password reset emails)
# Leave empty to disable password reset functionality
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI teacher assistant
# Docker Compose starts local Ollama automatically; OPENAI_API_KEY is optional.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_MODEL=qwen2.5:7b-instruct
AI_REVIEW_TIMEOUT_SECONDS=600
